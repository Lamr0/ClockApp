<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ClockApp"
             x:Class="ClockApp.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#05070D">
    
    <Grid x:Name="Root" Padding="16" RowSpacing="12" ColumnSpacing="12" RowDefinitions="*,*">

        <local:ClockView x:Name="ClockDisplay" Grid.Row="0" />

        <Grid x:Name="StopwatchPanel" Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="8">
            <local:StopwatchView x:Name="StopwatchDisplay" Grid.Row="0" />

            <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="16">
                <Button x:Name="StartStopBtn" Text="Старт" WidthRequest="130" Clicked="OnStartStopClicked" />
                <Button Text="Сброс" WidthRequest="130" Clicked="OnResetClicked" />
            </HorizontalStackLayout>
        </Grid>

    </Grid>

</ContentPage>